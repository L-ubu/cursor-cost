# One-time seed for the cookie jar (src/session.mjs persists rotations after first run).
# 1. Open https://cursor.com/dashboard/usage while logged in
# 2. DevTools → Application → Cookies → cursor.com
# 3. Easiest: DevTools → Network → reload usage page → copy full Cookie header
#    Must include WorkosCursorSessionToken, csrf-token, and cursor-web-target-synced-user
CURSOR_SESSION_COOKIE=

# Optional: monthly on-demand budget for the report bar (default 50)
# CURSOR_MONTHLY_BUDGET_USD=50
